{
  "name": "arkeo-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Admin UI build for Keplr/CosmJS browser bundle",
  "scripts": {
    "build": "esbuild src/keplr.ts --bundle --platform=browser --format=iife --global-name=Cosmos --target=es2020 --alias:crypto=./src/no-node-crypto.ts --inject:src/shims.ts --outfile=vendor/cosmos.bundle.js"
  },
  "dependencies": {
    "@cosmjs/proto-signing": "0.34.1",
    "@cosmjs/stargate": "0.34.1",
    "buffer": "6.0.3",
    "process": "0.11.10",
    "protobufjs": "7.6.6"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  },
  "overrides": {
    "protobufjs": "7.6.6"
  }
}
